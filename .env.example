# Copy to .env (git-ignored) to override the defaults used by docker-compose.yml.

# Database credentials. Leave commented to keep the defaults (astra / astra).
# PostgreSQL only applies these when its volume is first created: after that,
# changing them here breaks the backend login unless you also change the DB user's
# password or reset the volume (docker compose down -v, which deletes the data).
# POSTGRES_USER=astra
# POSTGRES_PASSWORD=astra

FRONTEND_PORT=3000

# AI analysis (optional). Put your own key here, never in source files.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Average seconds between random anomaly episodes in the simulated stream.
STREAM_EPISODE_MEAN_S=150
